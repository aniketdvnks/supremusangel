  {
   "fieldname": "how_it_works",
   "fieldtype": "HTML",
   "label": "How the Incentive Works",
   "options": "<div style=\"border:1px solid #d1d8dd;border-radius:8px;overflow:hidden;font-size:13px;line-height:1.6\">\n  <div style=\"background:#1f272e;color:#fff;padding:10px 14px;font-size:15px;font-weight:600\">\n    \ud83d\udcb0 How the Incentive Engine Works\n  </div>\n  <div style=\"padding:14px 16px;background:#fff;color:#36414c\">\n    <p style=\"margin:0 0 10px\">\n      This single screen holds <b>all</b> incentive rules. Sales are read live from confirmed\n      <b>Sales Invoices</b> (via each invoice's <i>Sales Team</i> allocation). Three schemes share one base:\n    </p>\n    <div style=\"background:#f4f5f6;border-left:3px solid #5e64ff;padding:8px 12px;margin:0 0 12px;font-family:monospace;font-size:12.5px\">\n      base_target&nbsp;&nbsp;&nbsp;= Salary &times; Target Multiple (10)<br>\n      minimum_target = Salary &times; Minimum Multiple (7)<br>\n      achievement %&nbsp;= Total Sales &divide; base_target &times; 100\n    </div>\n    <table style=\"width:100%;border-collapse:collapse;margin:0 0 14px\">\n      <thead><tr style=\"background:#f4f5f6;text-align:left\">\n        <th style=\"padding:6px 8px;border:1px solid #e2e6e9\">Scheme</th>\n        <th style=\"padding:6px 8px;border:1px solid #e2e6e9\">Reads which table below</th>\n        <th style=\"padding:6px 8px;border:1px solid #e2e6e9\">Earns</th>\n      </tr></thead>\n      <tbody>\n        <tr><td style=\"padding:6px 8px;border:1px solid #e2e6e9\"><b>Salesperson</b></td>\n            <td style=\"padding:6px 8px;border:1px solid #e2e6e9\">Salesperson (RM) Slabs</td>\n            <td style=\"padding:6px 8px;border:1px solid #e2e6e9\">Incentive (% of salary) + Reward (% above target)</td></tr>\n        <tr><td style=\"padding:6px 8px;border:1px solid #e2e6e9\"><b>Team Lead</b></td>\n            <td style=\"padding:6px 8px;border:1px solid #e2e6e9\">Manager Bonus + Manager Bands</td>\n            <td style=\"padding:6px 8px;border:1px solid #e2e6e9\">Personal payout + Team Commission % of team sales</td></tr>\n        <tr><td style=\"padding:6px 8px;border:1px solid #e2e6e9\"><b>Branch Manager</b></td>\n            <td style=\"padding:6px 8px;border:1px solid #e2e6e9\">Manager Bonus + Manager Bands</td>\n            <td style=\"padding:6px 8px;border:1px solid #e2e6e9\">Personal payout + tiered Branch Commission</td></tr>\n      </tbody>\n    </table>\n    <div style=\"background:#eafaf1;border:1px solid #b7e4c7;border-radius:6px;padding:12px 14px;margin:6px 0 4px\">\n      <div style=\"font-weight:600;color:#1b5e20;margin-bottom:6px\">\ud83d\udccc Example \u2014 Salesperson \"Sneha\"</div>\n      <table style=\"width:100%;border-collapse:collapse;font-size:12.5px\">\n        <tr><td style=\"padding:3px 6px\">Salary</td><td style=\"padding:3px 6px;text-align:right\"><b>&#8377;25,000</b></td></tr>\n        <tr><td style=\"padding:3px 6px\">Base target (&times;10)</td><td style=\"padding:3px 6px;text-align:right\">&#8377;2,50,000</td></tr>\n        <tr><td style=\"padding:3px 6px\">Sales this month</td><td style=\"padding:3px 6px;text-align:right\">&#8377;3,00,000</td></tr>\n        <tr><td style=\"padding:3px 6px\">Achievement</td><td style=\"padding:3px 6px;text-align:right\"><b>120%</b> &rarr; \"100% to below 140%\" slab</td></tr>\n        <tr><td style=\"padding:3px 6px\">Incentive = 30% &times; salary</td><td style=\"padding:3px 6px;text-align:right\">&#8377;7,500</td></tr>\n        <tr><td style=\"padding:3px 6px\">Reward = (3,00,000 &minus; 2,50,000) &times; 10%</td><td style=\"padding:3px 6px;text-align:right\">&#8377;5,000</td></tr>\n        <tr style=\"border-top:2px solid #1b5e20\"><td style=\"padding:5px 6px;font-weight:700\">Total Payout</td><td style=\"padding:5px 6px;text-align:right;font-weight:700;color:#1b5e20\">&#8377;12,500</td></tr>\n      </table>\n    </div>\n    <p style=\"margin:10px 0 0;color:#7c7c7c;font-size:12px\">\n      Below 70% &rarr; no incentive. Reward only above 100%. Calculate sellers first, then TLs, then BM.\n    </p>\n  </div>\n</div>"
  },
